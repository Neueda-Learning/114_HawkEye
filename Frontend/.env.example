# ─── API ───────────────────────────────────────────────
# Base URL for API calls (use / so Vite proxy forwards /api/* to backend)
VITE_API_BASE_URL=/

# ─── Feature Flags ─────────────────────────────────────
# Set to "true" to use MSW mock API instead of real backend
VITE_USE_MOCK_API=false

# ─── App ───────────────────────────────────────────────
VITE_APP_NAME=HawkEye
VITE_APP_VERSION=1.0.0

