# ─── API ───────────────────────────────────────────────
# Base URL of the Spring Boot backend
VITE_API_BASE_URL=http://localhost:8080

# ─── Feature Flags ─────────────────────────────────────
# Set to "true" to use MSW mock API instead of real backend
VITE_USE_MOCK_API=true

# ─── App ───────────────────────────────────────────────
VITE_APP_NAME=HawkEye
VITE_APP_VERSION=1.0.0

