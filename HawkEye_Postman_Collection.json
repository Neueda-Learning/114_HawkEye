    {
      "name": "RULE MANAGEMENT",
      "description": "Endpoints for managing rules and audit trails",
      "item": [
        {
          "name": "1. Create Rule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ruleName\": \"Daily Transfer Limit\",\n  \"description\": \"Alert if daily transfer exceeds $50,000\",\n  \"ruleType\": \"DAILY_LIMIT\",\n  \"severity\": \"HIGH\",\n  \"parameters\": {\n    \"dailyLimit\": 50000,\n    \"currency\": \"USD\"\n  },\n  \"createdBy\": \"admin\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/rules",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "rules"]
            }
          },
          "response": []
        },
