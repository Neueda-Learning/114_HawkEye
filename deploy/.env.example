# ============================================================
# HawkEye Environment Configuration Template
# ============================================================
#
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in real values in .env
#   3. NEVER commit .env to Git — add it to .gitignore
#
# WHERE THIS FILE LIVES:
#   deploy/.env  (same directory as docker-compose.app.yml)
#
# HOW DOCKER COMPOSE READS IT:
#   Docker Compose automatically loads .env from the same
#   directory as the compose file. Every ${VARIABLE} in
#   docker-compose.app.yml is replaced with values from here.
# ============================================================

# ──────────────────────────────────────────
# MySQL Database
# ──────────────────────────────────────────
MYSQL_DATABASE=txnd
MYSQL_USER=hawkeye
MYSQL_PASSWORD=your_db_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here

# ──────────────────────────────────────────
# Email / SMTP (for alert notifications)
# ──────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# SMTP security settings (these defaults are correct for Gmail)
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_TIMEOUT=5000

# ──────────────────────────────────────────
# Notification email recipients
# ──────────────────────────────────────────
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_FROM=your_email@gmail.com
NOTIFICATION_EMAIL_TO=recipient@example.com
NOTIFICATION_TX_RECIPIENTS=recipient@example.com
NOTIFICATION_ALERT_RECIPIENTS=recipient@example.com
NOTIFICATION_RULE_RECIPIENTS=recipient@example.com
