        {
          "name": "Get Alerts by Transaction ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "const list = json?.data ?? json ?? [];",
                  "if (Array.isArray(list) && list.length > 0) {",
                  "  const first = list[0];",
                  "  const alertId = first?.alertId ?? first?.id;",
                  "  if (alertId) pm.collectionVariables.set('alertId', String(alertId));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
