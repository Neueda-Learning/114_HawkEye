      "name": "Rule Management",
      "description": "Rule CRUD, status toggle, audit trail, and active rules list.",
      "item": [
        {
          "name": "Create Rule",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 or 200', function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "const id = json?.id ?? json?.data?.id;",
                  "if (id) { pm.collectionVariables.set('ruleId', String(id)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Daily Transfer Limit\",\n  \"description\": \"Alert if total debit amount for the day exceeds 50,000 USD\",\n  \"ruleType\": \"DAILY_LIMIT\",\n  \"severity\": \"HIGH\",\n  \"parameters\": {\n    \"dailyLimit\": 50000,\n    \"currency\": \"USD\"\n  },\n  \"performedBy\": \"admin\",\n  \"changeReason\": \"Initial onboarding of daily limit rule\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rules"
              ]
            },
            "description": "Creates a rule. Valid ruleType values: AMOUNT_THRESHOLD, VELOCITY, NEW_PAYEE, DAILY_LIMIT. Valid severity values: LOW, MEDIUM, HIGH, CRITICAL."
          },
          "response": []
        },
